DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"
R2_ACCOUNT_ID="your-cloudflare-account-id"
R2_ACCESS_KEY_ID="your-r2-access-key-id"
R2_SECRET_ACCESS_KEY="your-r2-secret-access-key"
R2_BUCKET_NAME="nandigo-media"
ADMIN_PASSWORD_HASH="$2a$12$replace-with-bcrypt-hash"

# Optional but strongly recommended for production R2 public delivery.
# Use a custom domain connected to the R2 bucket, e.g. https://media.nandigo.in
R2_PUBLIC_BASE_URL=""

# Optional site canonical origin.
NEXT_PUBLIC_SITE_URL="https://nandigo.in"
